{
  "name": "grafty-personal-portfolio",
  "version": "2.0.0",
  "description": "Full-Stack Portfolio application with React frontend and Express REST API backend",
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix backend",
    "install:all": "npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "portfolio",
    "developer",
    "designer",
    "react",
    "express",
    "fullstack"
  ],
  "author": "Sunny Kumar",
  "license": "MIT"
}
